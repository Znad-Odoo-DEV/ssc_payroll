    <!-- ==================================================================
         Labour vs staff separation. GROUP rules (not global), so they are
         OR-ed: each side's Officer and Manager both carry the same filter,
         and nobody is in both sides, so each user sees only their workforce.
         Staff = Engineer/Office employees (is_engineer_office); everyone else
         counts as labour.
         ================================================================== -->

    <record id="ssc_payslip_labour_rule" model="ir.rule">
        <field name="name">SSC Payslip: labour only</field>
        <field name="model_id" ref="model_ssc_payslip"/>
        <field name="groups" eval="[(4, ref('group_labour_payroll')), (4, ref('group_labour_payroll_manager'))]"/>
        <field name="domain_force">[('employee_id.is_engineer_office', '=', False)]</field>
    </record>
    <record id="ssc_payslip_staff_rule" model="ir.rule">
        <field name="name">SSC Payslip: staff only</field>
        <field name="model_id" ref="model_ssc_payslip"/>
        <field name="groups" eval="[(4, ref('group_staff_payroll')), (4, ref('group_staff_payroll_manager'))]"/>
