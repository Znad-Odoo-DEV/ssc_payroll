    <record id="ssc_attendance_sheet_company_rule" model="ir.rule">
        <field name="name">SSC Attendance Sheet: multi-company</field>
        <field name="model_id" ref="model_ssc_attendance_sheet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Labour Attendance Officers may delete attendance sheets only while they
         are still New (this rule applies to unlink only; read is unrestricted
         through the global company rule above). Managers are not covered by
         this rule, so they can delete in any state. -->
    <record id="ssc_attendance_sheet_officer_unlink_rule" model="ir.rule">
        <field name="name">SSC Attendance Sheet: officer deletes only New</field>
        <field name="model_id" ref="model_ssc_attendance_sheet"/>
        <field name="groups" eval="[(4, ref('group_labour_attendance'))]"/>
        <field name="domain_force">[('state', '=', 'new')]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Managers delete in any state. Record rules are OR-ed across a user's
         groups, so this permissive unlink rule lets anyone who is ALSO a
         Manager (including admins, who imply the Manager group) delete beyond
         New - otherwise the officer rule above would restrict them too. -->
    <record id="ssc_attendance_sheet_manager_unlink_rule" model="ir.rule">
        <field name="name">SSC Attendance Sheet: manager deletes any</field>
        <field name="model_id" ref="model_ssc_attendance_sheet"/>
        <field name="groups" eval="[(4, ref('group_labour_attendance_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

