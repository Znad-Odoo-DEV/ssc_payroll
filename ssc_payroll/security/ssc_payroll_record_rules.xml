<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ssc_employee_company_rule" model="ir.rule">
        <field name="name">SSC Employee: multi-company</field>
        <field name="model_id" ref="model_ssc_employee"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

