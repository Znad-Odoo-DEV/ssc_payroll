<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ssc_employee_list" model="ir.ui.view">
        <field name="name">ssc.employee.list</field>
        <field name="model">ssc.employee</field>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="employee_code"/>
                <field name="name"/>
                <field name="job_position"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_engineer_office"/>
                <field name="is_staff" optional="hide"/>
                <field name="basic_salary"/>
                <field name="gross_salary"/>
                <field name="visa_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ssc_employee_form" model="ir.ui.view">
        <field name="name">ssc.employee.form</field>
        <field name="model">ssc.employee</field>
        <field name="arch" type="xml">
            <form string="Employee">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Employee name"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="employee_code"/>
                            <field name="attendance_code"/>
                            <field name="hr_employee_id" readonly="1"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="job_position"/>
                            <field name="nationality"/>
                            <field name="date_of_birth"/>
                            <field name="phone"/>
                            <field name="active" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="hide_salary" invisible="1"/>
                        </group>
                        <group string="Classification">
                            <field name="is_engineer_office"/>
                            <field name="is_staff"/>
                            <field name="overtime_eligible"/>
                            <field name="visa_company"/>
                            <field name="joining_date"/>
                            <field name="is_cancelled"/>
                            <field name="approved_nor"/>
                            <field name="on_leave"/>
                            <field name="submitted_cancellation"/>
                            <field name="last_day" invisible="not submitted_cancellation"/>
                            <field name="end_of_service_date" invisible="not submitted_cancellation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Salary" name="salary" invisible="hide_salary">
                            <group>
                                <group string="Monthly Salary">
                                    <field name="basic_salary"/>
                                    <field name="house_allowance"/>
                                    <field name="transport_allowance"/>
                                    <field name="other_allowance"/>
                                    <field name="gross_salary"/>
                                    <field name="rate_per_day"/>
                                </group>
                                <group string="Overtime &amp; Allowances">
                                    <field name="ot_rate_regular"/>
                                    <field name="ot_rate_off"/>
                                    <field name="phone_bill_allowance"/>
                                    <field name="agreed_monthly_allowance"/>
                                </group>
                            </group>
                        </page>
                        <page string="Staff Project Distribution" name="staff_projects"
                              invisible="not is_engineer_office">
                            <field name="staff_project_ids">
                                <list editable="bottom">
                                    <field name="project_id"/>
                                    <field name="percentage"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Leave empty to split the salary equally over all
                                on-going construction projects.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ssc_employee_search" model="ir.ui.view">
        <field name="name">ssc.employee.search</field>
        <field name="model">ssc.employee</field>
        <field name="arch" type="xml">
            <search string="Employees">
                <field name="name"/>
                <field name="employee_code"/>
                <field name="attendance_code"/>
                <field name="job_position"/>
                <separator/>
                <filter name="staff" string="Engineer / Office Staff" domain="[('is_engineer_office', '=', True)]"/>
                <filter name="labour" string="Labour" domain="[('is_engineer_office', '=', False)]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_visa" string="Visa Company" context="{'group_by': 'visa_company'}"/>
                    <filter name="group_staff" string="Staff / Labour" context="{'group_by': 'is_engineer_office'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ssc_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">ssc.employee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ssc_employee_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first payroll employee</p>
        </field>
    </record>

</odoo>
