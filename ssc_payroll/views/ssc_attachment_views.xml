<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ssc_attachment_list" model="ir.ui.view">
        <field name="name">ssc.attachment.list</field>
        <field name="model">ssc.attachment</field>
        <field name="arch" type="xml">
            <list string="Attachments">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="type_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="day" optional="hide"/>
                <field name="value"/>
                <field name="signed_value" sum="Signed Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'attached'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ssc_attachment_form" model="ir.ui.view">
        <field name="name">ssc.attachment.form</field>
        <field name="model">ssc.attachment</field>
        <field name="arch" type="xml">
            <form string="Attachment">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Description"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="type_id"/>
                            <field name="factor"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="month"/>
                            <field name="year"/>
                            <field name="day"/>
                            <field name="value"/>
                            <field name="signed_value"/>
                            <field name="payslip_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ssc_attachment_search" model="ir.ui.view">
        <field name="name">ssc.attachment.search</field>
        <field name="model">ssc.attachment</field>
        <field name="arch" type="xml">
            <search string="Attachments">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="type_id"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="attached" string="Attached" domain="[('state', '=', 'attached')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ssc_attachment" model="ir.actions.act_window">
        <field name="name">Attachments List</field>
        <field name="res_model">ssc.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ssc_attachment_search"/>
    </record>

</odoo>
