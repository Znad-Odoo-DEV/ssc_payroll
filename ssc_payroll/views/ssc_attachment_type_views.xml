<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ssc_attachment_type_list" model="ir.ui.view">
        <field name="name">ssc.attachment.type.list</field>
        <field name="model">ssc.attachment.type</field>
        <field name="arch" type="xml">
            <list string="Attachment Types" editable="bottom">
                <field name="name"/>
                <field name="kind"/>
                <field name="factor"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_ssc_attachment_type" model="ir.actions.act_window">
        <field name="name">Attachment Types</field>
        <field name="res_model">ssc.attachment.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
