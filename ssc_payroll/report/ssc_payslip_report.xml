<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_ssc_payslip" model="ir.actions.report">
        <field name="name">Payslip</field>
        <field name="model">ssc.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ssc_payroll.report_ssc_payslip</field>
        <field name="report_file">ssc_payroll.report_ssc_payslip</field>
        <field name="binding_model_id" ref="model_ssc_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_ssc_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center" t-out="doc.name"/>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Employee:</strong> <span t-field="doc.employee_id"/><br/>
                                <strong>Employee ID:</strong> <span t-field="doc.employee_code"/><br/>
                                <strong>Designation:</strong> <span t-field="doc.designation"/><br/>
                                <strong>Company:</strong> <span t-field="doc.company_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Batch:</strong> <span t-field="doc.batch_id"/><br/>
                                <strong>Period:</strong>
                                <span t-field="doc.from_date"/> - <span t-field="doc.to_date"/><br/>
                                <strong>Days:</strong> <span t-field="doc.days"/><br/>
                                <strong>Payment:</strong>
                                <span t-out="'Cash' if doc.is_cash else 'WPS'"/>
                            </div>
                        </div>

                        <h4 class="mt-4">Contract Details</h4>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td><strong>Basic Salary</strong></td>
                                <td class="text-end"><span t-field="doc.basic_salary"/></td>
                                <td><strong>House Allowance</strong></td>
                                <td class="text-end"><span t-field="doc.house_allowance"/></td>
                            </tr>
                            <tr>
                                <td><strong>Travelling Allowance</strong></td>
                                <td class="text-end"><span t-field="doc.transport_allowance"/></td>
                                <td><strong>Other Allowances</strong></td>
                                <td class="text-end"><span t-field="doc.other_allowance"/></td>
                            </tr>
                            <tr>
                                <td><strong>Total Gross Salary</strong></td>
                                <td class="text-end"><span t-field="doc.gross_salary"/></td>
                                <td><strong>Rate per Day</strong></td>
                                <td class="text-end"><span t-field="doc.rate_per_day"/></td>
                            </tr>
                        </table>

                        <h4 class="mt-3">Salary &amp; Work Entries</h4>
                        <table class="table table-sm">
                            <tr>
                                <td>Total Attendance for This Month</td>
                                <td class="text-end"><span t-field="doc.total_attendance"/></td>
                            </tr>
                            <tr>
                                <td>Overtime (Regular / Off Days)</td>
                                <td class="text-end">
                                    <span t-field="doc.overtime_reg"/> / <span t-field="doc.overtime_off"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Total Salary of this Month</td>
                                <td class="text-end"><span t-field="doc.total_salary"/></td>
                            </tr>
                            <tr>
                                <td>Total Overtime Salary</td>
                                <td class="text-end"><span t-field="doc.overtime_salary"/></td>
                            </tr>
                            <tr>
                                <td>Salary Adjustment</td>
                                <td class="text-end"><span t-field="doc.salary_adjustment"/></td>
                            </tr>
                            <tr class="border-top">
                                <td><strong>Net Amount</strong></td>
                                <td class="text-end"><strong><span t-field="doc.net_amount"/></strong></td>
                            </tr>
                        </table>

                        <t t-if="doc.attachment_ids">
                            <h4 class="mt-3">Salary Attachments</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Type</th><th>Description</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.attachment_ids" t-as="att">
                                        <td t-field="att.type_id"/>
                                        <td t-field="att.name"/>
                                        <td class="text-end" t-field="att.signed_value"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="doc.project_ids">
                            <h4 class="mt-3">Project Distribution</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th class="text-end">Days</th>
                                        <th class="text-end">Salary</th>
                                        <th class="text-end">OT Reg (h)</th>
                                        <th class="text-end">OT Off (h)</th>
                                        <th class="text-end">Overtime</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-end">Share</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.project_ids" t-as="p">
                                        <td t-field="p.project_id"/>
                                        <td class="text-end" t-field="p.total_attendance"/>
                                        <td class="text-end" t-field="p.salary_amount"/>
                                        <td class="text-end" t-field="p.total_overtime_reg"/>
                                        <td class="text-end" t-field="p.total_overtime_off"/>
                                        <td class="text-end" t-field="p.total_overtime_amount"/>
                                        <td class="text-end" t-field="p.total_amount"/>
                                        <td class="text-end">
                                            <span t-esc="'%.1f%%' % p.share"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
