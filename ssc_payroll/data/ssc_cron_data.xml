<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- TEMPORARY: mirror Studio x_attachments_list into ssc.attachment. -->
    <record id="cron_sync_studio_attachments" model="ir.cron">
        <field name="name">SSC Payroll: Sync Studio Attachments</field>
        <field name="model_id" ref="model_ssc_attachment"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_studio_attachments()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="datetime.now()"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Manual trigger from the Attachments List "Action" menu. -->
    <record id="action_server_sync_studio_attachments" model="ir.actions.server">
        <field name="name">Sync Attachments from Studio</field>
        <field name="model_id" ref="model_ssc_attachment"/>
        <field name="binding_model_id" ref="model_ssc_attachment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model._cron_sync_studio_attachments()</field>
    </record>

</odoo>
